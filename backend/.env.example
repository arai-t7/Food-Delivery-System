# По умолчанию используется SQLite, файл backend/food_crm.db.
# Для PostgreSQL раскомментируйте строку и подставьте параметры своей базы.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/food_crm

# Для локального демо можно оставить значения по умолчанию.
# Для развёртывания задайте свой секрет и отключите демо-учётки.
# JWT_SECRET=
JWT_EXPIRE_DAYS=7
SEED_DEMO=true

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
